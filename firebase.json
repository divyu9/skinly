{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/initiatePayment/**", "function": "initiatePayment", "region": "us-central1" },
      { "source": "/api/initiatePayment", "function": "initiatePayment", "region": "us-central1" },
      { "source": "/api/checkPaymentStatus/**", "function": "checkPaymentStatus", "region": "us-central1" },
      { "source": "/api/checkPaymentStatus", "function": "checkPaymentStatus", "region": "us-central1" },
      { "source": "/api/createOrder/**", "function": "createOrder", "region": "us-central1" },
      { "source": "/api/createOrder", "function": "createOrder", "region": "us-central1" },
      { "source": "/api/sendWhatsAppMessage/**", "function": "sendWhatsAppMessage", "region": "us-central1" },
      { "source": "/api/sendWhatsAppMessage", "function": "sendWhatsAppMessage", "region": "us-central1" },
      { "source": "/api/createShipment/**", "function": "createShipment", "region": "us-central1" },
      { "source": "/api/createShipment", "function": "createShipment", "region": "us-central1" },
      { "source": "/api/generateUploadUrl/**", "function": "generateUploadUrl", "region": "us-central1" },
      { "source": "/api/generateUploadUrl", "function": "generateUploadUrl", "region": "us-central1" },
      { "source": "/api/generateSEOContent/**", "function": "generateSEOContent", "region": "us-central1" },
      { "source": "/api/generateSEOContent", "function": "generateSEOContent", "region": "us-central1" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
