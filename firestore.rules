rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Rules combine with OR: a narrower `allow ... if false` can never revoke a
    // broader `allow ... if true` declared elsewhere. So there is no catch-all
    // grant here — every collection states its own access, and anything not
    // listed is denied.
    //
    // Admin is proven by a custom claim on the ID token, which only the Admin
    // SDK can mint. It must never be read from a document the user can write:
    // users/{uid} is self-writable, so an `isAdmin` field there would let any
    // customer grant themselves the whole database.
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Fields a customer must never set on their own user document.
    function noPrivilegedFields() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['isAdmin', 'walletBalance', 'role', 'permissions']);
    }

    // ── Public catalogue ──────────────────────────────────────────────────────
    // Read-only to the world; written by admins through the dashboard.
    match /products/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /variants/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /collections/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /collectionProducts/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /phoneCollections/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /mockups/{id}                  { allow read: if true; allow write: if isAdmin(); }
    match /modelMetadata/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /supportedModels/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /gadgetTypes/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /finishTypes/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /productSectionContent/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /productCategoriesConfig/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /categoryDisplaySettings/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /trendingProductsConfig/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /suggestedProductsConfig/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /checkoutUpsells/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /homepageSettings/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /homepageSections/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /homepageSectionCards/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /heroSlides/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /featureBanners/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /ugcVideos/{id}                { allow read: if true; allow write: if isAdmin(); }
    match /seoPages/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /seoPageTemplates/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /walletSettings/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /codSettings/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /cashbackRules/{id}            { allow read: if true; allow write: if isAdmin(); }

    // Coupons are validated in the browser, so the codes have to be readable.
    // The discount is recomputed server-side in placeOrder, so a tampered
    // client cannot turn a readable code into a cheaper order.
    match /coupons/{id}                  { allow read: if true; allow write: if isAdmin(); }

    // Reviews are public to read; a signed-in customer may add one.
    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    // Documents were imported from the previous backend keyed by ITS ids, so
    // users/{docId} is almost never the caller's auth uid — the uid lives in
    // `clerkId`. Ownership has to be matched on the fields, not the key, or
    // every customer loses their own profile and wallet.
    function ownsUserDoc(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.clerkId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
    }

    match /users/{userId} {
      allow get: if isAdmin() || ownsUserDoc(userId);
      // The app resolves a legacy doc with where('email','==',myEmail). This
      // rule makes exactly that query legal and nothing wider.
      allow list: if isAdmin()
                  || (isSignedIn() && request.auth.token.email != null
                      && resource.data.email == request.auth.token.email);
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(['isAdmin', 'walletBalance', 'role', 'permissions']);
      allow update: if isAdmin() || (ownsUserDoc(userId) && noPrivilegedFields());
      allow delete: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────────────
    // One order is fetchable by anyone holding its document id — that is how
    // guest tracking works, and the ids are unguessable. Listing now needs a
    // signed-in caller, which ends the anonymous dump of the whole order book.
    //
    // Deliberately not yet scoped to the caller's own orders: `userId` on live
    // data is a mix of auth uids, legacy user-doc ids, session ids and nulls, so
    // `resource.data.userId == request.auth.uid` would hide 48 real orders from
    // the customers who placed them. Tightening needs the userId backfill.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Cart ──────────────────────────────────────────────────────────────────
    // Guest carts are keyed by a sessionId rules cannot verify, so those rows
    // stay open. Rows owned by a signed-in customer are locked to them, which
    // stops anyone planting priced items in someone else's cart.
    match /cart/{cartId} {
      allow create: if true;
      allow read, update, delete: if isAdmin()
                                  || !('userId' in resource.data)
                                  || resource.data.userId == null
                                  || isOwner(resource.data.userId);
    }

    // ── Money ─────────────────────────────────────────────────────────────────
    match /walletTransactions/{txnId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Same legacy-id caveat as orders: rows still carry the old user-doc id.
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /couponUsage/{id} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Customer-submitted forms ──────────────────────────────────────────────
    // Anyone may submit; only admins may read them back.
    match /bugReports/{id}        { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /bugAttachments/{id}    { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /modelRequests/{id}     { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /stockNotifications/{id}{ allow create: if true; allow read, update, delete: if isAdmin(); }

    // ── Login codes ───────────────────────────────────────────────────────────
    // Only the Admin SDK inside Cloud Functions touches these. With the
    // catch-all gone, this denial is finally effective.
    match /loginOtps/{id}         { allow read, write: if false; }
    match /rateLimits/{id}        { allow read, write: if false; }

    // ── Admin-only back office ────────────────────────────────────────────────
    match /abandonedCarts/{id}          { allow read, write: if isAdmin(); }
    match /abandonedCartSettings/{id}   { allow read, write: if isAdmin(); }
    match /whatsappMessages/{id}        { allow read, write: if isAdmin(); }
    match /whatsappQueue/{id}           { allow read, write: if isAdmin(); }
    match /whatsappTemplates/{id}       { allow read, write: if isAdmin(); }
    match /whatsappUsecases/{id}        { allow read, write: if isAdmin(); }
    match /whatsappSettings/{id}        { allow read, write: if isAdmin(); }
    match /whatsappDebugLogs/{id}       { allow read, write: if isAdmin(); }
    match /emailUsecaseTemplates/{id}   { allow read, write: if isAdmin(); }
    match /mediaLibrary/{id}            { allow read, write: if isAdmin(); }
    match /uploadJobs/{id}              { allow read, write: if isAdmin(); }
    match /googleDriveImportJobs/{id}   { allow read, write: if isAdmin(); }
    match /rollInventory/{id}           { allow read, write: if isAdmin(); }
    // AI mockup studio: prompt overrides and generation jobs. Admin-only both
    // ways — the prompts steer a billed API and the jobs carry task ids.
    match /gadgetMockupPrompts/{id}     { allow read, write: if isAdmin(); }
    match /designMockups/{id}           { allow read, write: if isAdmin(); }
    match /gadgetMockupSettings/{id}    { allow read, write: if isAdmin(); }
    match /cutoutInventory/{id}         { allow read, write: if isAdmin(); }
    match /gadgetConsumption/{id}       { allow read, write: if isAdmin(); }
    match /variantConsumptionPresets/{id} { allow read, write: if isAdmin(); }
  }
}
