rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Utility Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'chandan1992@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Global Public Reads (Products, Pages, Mockups, etc)
    // Allows your public catalog to render without authentication
    match /{document=**} {
      allow read: if true; 
      // By default, no one can write anywhere unless explicitly allowed below
      allow write: if isAdmin();
    }

    // Only the Cloud Functions (Admin SDK) should touch OTP records.
    // NOTE: this block is currently inert — rules combine with OR, so the
    // catch-all `allow read: if true` above still grants read here. It becomes
    // effective only once that catch-all is narrowed. Until then the codes are
    // protected by being stored as a peppered hash, never in plaintext.
    match /loginOtps/{docId} {
      allow read, write: if false;
    }

    // 3. User Profiles & Wallet
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /walletTransactions/{txnId} {
      // Users can see their own wallet transactions
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Only admins (or backend cloud functions) can create/update transactions
      allow write: if isAdmin();
    }

    // 4. Orders
    match /orders/{orderId} {
      // Users can read their own orders. Guests can read if they have the tracking token (handled by app logic/backend)
      allow read: if isOwner(resource.data.userId) || resource.data.userId == 'guest' || isAdmin();
      // NO DIRECT CLIENT WRITES! 
      // Orders are created/updated exclusively by the secure Cloud Function
      allow write: if isAdmin();
    }

    // 5. Cart
    match /cart/{cartId} {
      // Anyone (even guests) can read/write to the cart. 
      // The application relies on `userId` or `sessionId` to filter carts.
      allow read, write: if true;
    }

    // 6. Settings & Sensitive Configs
    match /settings/{settingId} {
      // Public can read basic settings (like logo URLs)
      allow read: if true;
      // Only admins can modify settings
      allow write: if isAdmin();
    }
  }
}
