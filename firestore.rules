rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Rules combine with OR: a narrower `allow ... if false` can never revoke a
    // broader `allow ... if true` declared elsewhere. So there is no catch-all
    // grant here — every collection states its own access, and anything not
    // listed is denied.
    //
    // Admin is proven by a custom claim on the ID token, which only the Admin
    // SDK can mint. It must never be read from a document the user can write:
    // users/{uid} is self-writable, so an `isAdmin` field there would let any
    // customer grant themselves the whole database.
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Fields a customer must never set on their own user document.
    function noPrivilegedFields() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['isAdmin', 'walletBalance', 'role', 'permissions', 'referralCount', 'referralEarnings', 'referralCode']);
    }

    // ── Public catalogue ──────────────────────────────────────────────────────
    // Read-only to the world; written by admins through the dashboard.
    match /products/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /variants/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /collections/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /collectionProducts/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /phoneCollections/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /mockups/{id}                  { allow read: if true; allow write: if isAdmin(); }
    match /modelMetadata/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /supportedModels/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /gadgetTypes/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /finishTypes/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /productSectionContent/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /productCategoriesConfig/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /categoryDisplaySettings/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /trendingProductsConfig/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /suggestedProductsConfig/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /checkoutUpsells/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /homepageSettings/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /homepageSections/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /homepageSectionCards/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /heroSlides/{id}               { allow read: if true; allow write: if isAdmin(); }
    match /featureBanners/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /ugcVideos/{id}                { allow read: if true; allow write: if isAdmin(); }
    match /seoPages/{id}                 { allow read: if true; allow write: if isAdmin(); }
    match /seoPageTemplates/{id}         { allow read: if true; allow write: if isAdmin(); }
    // Read is public because the storefront needs the shipping fee, the Meta
    // pixel id and a few counters before anyone signs in. That makes this the
    // worst place in the database for a secret — and two OpenAI keys and a
    // WhatsApp auth key were sitting here, downloadable by anyone who knew the
    // project id. They are gone; this stops the next one arriving.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin() && !looksLikeASecret();
    }
    // Both halves read `value` through get(): a settings document that has no
    // `value` field at all — shipping, the counters, the pixel id — used to
    // pass the `is string` test on the default and then fail evaluating
    // `.value`, and a rule that errors is a rule that denies. Every such save
    // was refused from the day this was written.
    function looksLikeASecret() {
      return request.resource.data.keys().hasAny(['authKey', 'apiKey', 'secret', 'password', 'token'])
        || (request.resource.data.get('value', '') is string
            && request.resource.data.get('value', '').matches('(sk-|sk_|key-|Bearer ).*'));
    }
    match /walletSettings/{id}           { allow read: if true; allow write: if isAdmin(); }
    match /codSettings/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /cashbackRules/{id}            { allow read: if true; allow write: if isAdmin(); }

    // Coupons are validated in the browser, so the codes have to be readable.
    // The discount is recomputed server-side in placeOrder, so a tampered
    // client cannot turn a readable code into a cheaper order.
    match /coupons/{id}                  { allow read: if true; allow write: if isAdmin(); }

    // Reviews are public to read. They are written by submitOrderReview
    // (functions/src/reviews.ts), which checks the order was delivered and
    // the product was in it. `create: if isSignedIn()` let any Google account
    // post any review of anything.
    // Models found in the plotter software, waiting for approval
    // (functions/src/plotterModels.ts writes them; admins read them).
    match /plotterModels/{id} { allow read: if isAdmin(); allow write: if false; }
    // The plotter PC's daily uploads: when each vendor's list last arrived (pltSync.ts).
    match /pltSync/{id} { allow read: if isAdmin(); allow write: if false; }
    // Each phone model's mockup design codes, kept by functions (mockupCoverage.ts).
    match /mockupCoverage/{id} { allow read: if isAdmin(); allow write: if false; }
    // Which account owns each referral code; written only by functions (referrals.ts).
    match /referralCodes/{code} { allow read: if isAdmin(); allow write: if false; }

    match /reviews/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    // Documents were imported from the previous backend keyed by ITS ids, so
    // users/{docId} is almost never the caller's auth uid — the uid lives in
    // `clerkId`. Ownership has to be matched on the fields, not the key, or
    // every customer loses their own profile and wallet.
    function ownsUserDoc(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.clerkId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
    }

    match /users/{userId} {
      allow get: if isAdmin() || ownsUserDoc(userId);
      // The app resolves a legacy doc with where('email','==',myEmail). This
      // rule makes exactly that query legal and nothing wider.
      allow list: if isAdmin()
                  || (isSignedIn() && request.auth.token.email != null
                      && resource.data.email == request.auth.token.email);
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(['isAdmin', 'walletBalance', 'role', 'permissions', 'referralCount', 'referralEarnings', 'referralCode']);
      allow update: if isAdmin() || (ownsUserDoc(userId) && noPrivilegedFields());
      allow delete: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────────────
    // One order is fetchable by anyone holding its document id — that is how
    // guest tracking works, and the ids are unguessable.
    match /orders/{orderId} {
      allow get: if true;
      // A customer lists only their own orders, by ownerUid (set at checkout,
      // on a guest claim, and backfilled; see functions/src/ownership.ts).
      // This was `isSignedIn()`, which let any Google account read every
      // customer's name, phone and address.
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Cart ──────────────────────────────────────────────────────────────────
    // Guest carts are keyed by a sessionId rules cannot verify, so those rows
    // stay open. Rows owned by a signed-in customer are locked to them, which
    // stops anyone planting priced items in someone else's cart.
    match /cart/{cartId} {
      allow create: if true;
      allow read, update, delete: if isAdmin()
                                  || !('userId' in resource.data)
                                  || resource.data.userId == null
                                  || isOwner(resource.data.userId);
    }

    // ── Money ─────────────────────────────────────────────────────────────────
    match /walletTransactions/{txnId} {
      allow get: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid
                                                  || resource.data.ownerUid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /couponUsage/{id} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Customer-submitted forms ──────────────────────────────────────────────
    // Anyone may submit; only admins may read them back. Each form may carry
    // only the fields the site sends, at sane sizes: a model request sends a
    // WhatsApp to the number in it, and a "notify me" row gets one on restock,
    // so an open `create: if true` let a script point our WhatsApp account at
    // any number, as often as it liked. Volume is capped where the messages
    // are sent (modelRequests.ts, restock.ts); these stop the junk rows.
    function str(v, max) { return v is string && v.size() <= max; }
    function phoneLike(v) { return v is string && v.matches('^[+]?[0-9 ]{10,16}$'); }

    match /bugReports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['bugId', 'userEmail', 'userPhone', 'bugDetails',
                         'userId', 'status', 'pageUrl', 'userAgent', 'createdAt'])
                    && str(request.resource.data.bugDetails, 5000)
                    && request.resource.data.get('status', 'open') == 'open';
      allow read, update, delete: if isAdmin();
    }
    match /bugAttachments/{id} {
      allow create: if request.resource.data.keys().hasOnly(['bugReportId', 'fileId', 'fileName', 'fileSize', 'fileType', 'createdAt'])
                    && exists(/databases/$(database)/documents/bugReports/$(request.resource.data.bugReportId));
      allow read, update, delete: if isAdmin();
    }
    match /modelRequests/{id} {
      allow create: if isAdmin() || (
                       request.resource.data.keys().hasOnly(['brandName', 'modelName', 'category', 'whatsappPhone',
                         '_creationTime', 'userId', 'userEmail'])
                    && str(request.resource.data.brandName, 60) && request.resource.data.brandName.size() > 0
                    && str(request.resource.data.modelName, 80) && request.resource.data.modelName.size() > 0
                    && str(request.resource.data.get('category', ''), 20)
                    && phoneLike(request.resource.data.whatsappPhone));
      allow read, update, delete: if isAdmin();
    }
    match /stockNotifications/{id} {
      allow create: if isAdmin() || (
                       request.resource.data.keys().hasOnly(['variantId', 'productId', 'productTitle', 'productSlug',
                         'variantTitle', 'sku', 'phoneNumber', 'userId', 'userEmail', 'status', 'createdAt'])
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.phoneNumber is string
                    && request.resource.data.phoneNumber.matches('^[6-9][0-9]{9}$')
                    && id == request.resource.data.variantId + '_' + request.resource.data.phoneNumber
                    && exists(/databases/$(database)/documents/variants/$(request.resource.data.variantId)));
      allow read, update, delete: if isAdmin();
    }

    // ── Login codes ───────────────────────────────────────────────────────────
    // Only the Admin SDK inside Cloud Functions touches these. With the
    // catch-all gone, this denial is finally effective.
    match /loginOtps/{id}         { allow read, write: if false; }
    match /rateLimits/{id}        { allow read, write: if false; }

    // ── Admin-only back office ────────────────────────────────────────────────
    match /abandonedCarts/{id}          { allow read, write: if isAdmin(); }
    match /abandonedCartSettings/{id}   { allow read, write: if isAdmin(); }
    match /whatsappMessages/{id}        { allow read, write: if isAdmin(); }
    match /whatsappQueue/{id}           { allow read, write: if isAdmin(); }
    match /whatsappTemplates/{id}       { allow read, write: if isAdmin(); }
    match /whatsappUsecases/{id}        { allow read, write: if isAdmin(); }
    match /whatsappSettings/{id}        { allow read, write: if isAdmin(); }
    match /whatsappDebugLogs/{id}       { allow read, write: if isAdmin(); }
    match /emailUsecaseTemplates/{id}   { allow read, write: if isAdmin(); }
    match /mediaLibrary/{id}            { allow read, write: if isAdmin(); }
    match /uploadJobs/{id}              { allow read, write: if isAdmin(); }
    match /googleDriveImportJobs/{id}   { allow read, write: if isAdmin(); }
    match /rollInventory/{id}           { allow read, write: if isAdmin(); }
    // AI mockup studio: prompt overrides and generation jobs. Admin-only both
    // ways — the prompts steer a billed API and the jobs carry task ids.
    match /gadgetMockupPrompts/{id}     { allow read, write: if isAdmin(); }
    match /designMockups/{id}           { allow read, write: if isAdmin(); }
    // Design launches: the plan for one design and its progress, run by
    // functions/src/launch.ts.
    match /designLaunches/{id}          { allow read, write: if isAdmin(); }
    match /gadgetMockupSettings/{id}    { allow read, write: if isAdmin(); }
    match /cutoutInventory/{id}         { allow read, write: if isAdmin(); }
    match /gadgetConsumption/{id}       { allow read, write: if isAdmin(); }
    match /variantConsumptionPresets/{id} { allow read, write: if isAdmin(); }
  }
}
