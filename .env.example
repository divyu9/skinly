# ============================================
# GoSkinly Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# Convex
CONVEX_DEPLOYMENT=your-convex-deployment-url
VITE_CONVEX_URL=https://your-project.convex.cloud

# Site URL
VITE_SITE_URL=https://www.goskinly.com

# PhonePe Payment
PHONEPE_MERCHANT_ID=your-merchant-id
PHONEPE_SALT_KEY=your-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_ENVIRONMENT=PRODUCTION

# RapidShyp Shipping
RAPIDSHYP_API_KEY=your-api-key

# MSG91 Email
MSG91_AUTH_TOKEN=your-auth-token

# Google Drive (for imports)
GOOGLE_DRIVE_API_KEY=your-api-key

# OpenAI (for SEO generation)
OPENAI_API_KEY=your-api-key

# WhatsApp (AuthKey)
# Note: WhatsApp settings are stored in database, not env

# Facebook Pixel
VITE_FB_PIXEL_ID=your-pixel-id

# Google Analytics
VITE_GA_MEASUREMENT_ID=your-ga-id
